    <ui:VisualElement style="flex-grow: 1; flex-direction: column; align-items: center; justify-content: space-between;">
        <ui:Label text="ステージをスキャン中…" style="font-size: 120%; -unity-font-definition: url(&quot;project://database/Assets/_Projects/Fonts/x8y12pxDenkiChip.ttf?fileID=12800000&amp;guid=03d054a9a5c71074a996b9363c031c69&amp;type=3#x8y12pxDenkiChip&quot;); -unity-text-outline-width: 2px; color: rgb(0, 0, 0); -unity-text-outline-color: rgb(255, 255, 255); top: 8%; -unity-font-style: normal; -unity-text-align: middle-center;"/>

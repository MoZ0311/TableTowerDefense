.unity-button {
    width: 64%;
    height: 24%;
    margin-bottom: 4%;
    font-size: 512%;
    border-radius: 40px;
    -unity-font-definition: url("project://database/Assets/_Projects/Fonts/x8y12pxDenkiChip.ttf?fileID=12800000&guid=03d054a9a5c71074a996b9363c031c69&type=3#x8y12pxDenkiChip");
    -unity-text-outline-color: rgb(255, 255, 255);
    -unity-text-outline-width: 1px;
    transition-duration: 0.2s;
}

.unity-button:active {
    scale: 0.95 0.95;
}
